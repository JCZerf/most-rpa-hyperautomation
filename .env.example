# ============================================================
# API (Django + Auth)
# ============================================================
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=False
# Produção (Cloud Run) + hosts locais
ALLOWED_HOSTS=127.0.0.1,localhost,*.run.app

# JWT/OAuth2
API_MASTER_KEY=change-me-to-a-random-master-key-with-at-least-32-chars
# Expiração de segurança para token ainda não consumido (/api/token -> /api/consulta)
API_TOKEN_TTL=600
OAUTH_CLIENT_ID=change-me-client-id
OAUTH_CLIENT_SECRET=change-me-client-secret
OAUTH_AUDIENCE=most-rpa-api

# Gunicorn (usado em deploy/container)
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=600


# ============================================================
# BOT Runtime (API + runner local)
# ============================================================
# Browser fixo em 1; ajuste somente abas simultâneas.
BOT_MAX_CONSULTAS_POR_BROWSER=4
# Default da API quando cliente não envia incluir_base64
BOT_INCLUDE_BASE64_DEFAULT=true


# ============================================================
# Playwright / Browser
# Docs: https://playwright.dev/python/docs/api/class-browser#browser-new-context-options
# ============================================================
PLAYWRIGHT_CHANNEL=chromium
PLAYWRIGHT_STORAGE_STATE_PATH=
PLAYWRIGHT_USE_STEALTH_FLAGS=true
PLAYWRIGHT_HIDE_WEBDRIVER=true
PLAYWRIGHT_USE_STEALTH_PACKAGE=true
PLAYWRIGHT_SLOW_MO_MS=0
PLAYWRIGHT_BLOCK_RESOURCE_TYPES=

# Bloqueio inteligente de imagens (opcional)
PLAYWRIGHT_BLOCK_IMAGE_MODE=third_party
PLAYWRIGHT_PRIMARY_DOMAIN=portaldatransparencia.gov.br
PLAYWRIGHT_IMAGE_ALLOW_PATTERNS=captcha,challenge,recaptcha,hcaptcha,cloudflare,human


# ============================================================
# Stress Runner (docker-compose.bot-stress.yml)
# ============================================================
BOT_CONSULTA=
BOT_CONSULTAS_JSON=
BOT_REFINAR_BUSCA=true
BOT_HEADLESS=true
BOT_INCLUIR_BASE64=false
BOT_OUTPUT_DIR=output/stress-bot

# Prefixo BOT_* mapeia para envs PLAYWRIGHT_* no compose de stress
BOT_PLAYWRIGHT_SLOW_MO_MS=20
BOT_PLAYWRIGHT_BLOCK_RESOURCE_TYPES=font,media
BOT_PLAYWRIGHT_BLOCK_IMAGE_MODE=third_party
BOT_PLAYWRIGHT_PRIMARY_DOMAIN=portaldatransparencia.gov.br
BOT_PLAYWRIGHT_IMAGE_ALLOW_PATTERNS=captcha,challenge,recaptcha,hcaptcha,cloudflare,human


# ============================================================
# E2E Smoke (local e CI)
# ============================================================
# Base da API online (sem barra no final)
E2E_BASE_URL=https://your-service.run.app
# Credenciais OAuth2 válidas no ambiente alvo
E2E_CLIENT_ID=
E2E_CLIENT_SECRET=

# Cenário unitário concorrente (1 false + 1 true)
E2E_CONSULTA_BASE=
E2E_CONSULTA_REFINADA=

# Cenários batch/paralelo:
# Lista de alvos separada por ';' (mínimo 2 para executar batch)
# Exemplo:
# E2E_BATCH_TARGETS=A LIDA PEREIRA FIALHO;A ANNE CHRISTINE SILVA RIBEIRO;GAABI OLIVEIRA DE MESQUITA;HAABE OLIVEIRA DA SILVA
E2E_BATCH_TARGETS=

# Modo estrito (recomendado em CI)
E2E_REQUIRE_SUCCESS=true
