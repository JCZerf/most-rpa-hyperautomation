DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
API_MASTER_KEY=change-me-to-a-random-master-key-with-at-least-32-chars
DEBUG=False
# Inclua seu domínio de produção (Cloud Run) e hosts locais para desenvolvimento
ALLOWED_HOSTS=127.0.0.1,localhost,*.run.app
# Expiração de segurança para token ainda não consumido (token é de uso único em /api/consulta/)
API_TOKEN_TTL=600
OAUTH_CLIENT_ID=change-me-client-id
OAUTH_CLIENT_SECRET=change-me-client-secret
OAUTH_AUDIENCE=most-rpa-api

# E2E smoke (API online)
# Obrigatorias para rodar tests/test_e2e_smoke.py -m e2e
E2E_BASE_URL=
E2E_CLIENT_ID=
E2E_CLIENT_SECRET=
E2E_CONSULTA_BASE=
# Opcional: se vazio, usa E2E_CONSULTA_BASE
E2E_CONSULTA_REFINADA=
# Quando true, exige sucesso funcional (HTTP 200) nos cenarios concorrentes
E2E_REQUIRE_SUCCESS=false

# Cenarios E2E adicionais (lote/limites/concurrency)
# Habilita testes opcionais de limite e requisicoes simultaneas com lote
E2E_ENABLE_LIMITS_SCENARIOS=false
# Tamanho do lote no cenario de validacao de limites
E2E_BATCH_SIZE=6
# Usa refinar_busca=true no cenario de lote (default false)
E2E_BATCH_REFINAR=false
# Quantidade de requisicoes simultaneas no cenario concorrente
E2E_PARALLEL_REQUESTS=3
# Quantidade de consultas por requisicao no cenario concorrente
E2E_PARALLEL_BATCH_SIZE=4

# Concurrency defaults (API + bot async)
# Browser fixo em 1; ajuste apenas a quantidade de abas simultaneas.
BOT_MAX_CONSULTAS_POR_BROWSER=4
# Default para API quando o cliente nao enviar "incluir_base64"
BOT_INCLUDE_BASE64_DEFAULT=true

# Configurações do Playwright, detalhes na documentação oficial: https://playwright.dev/python/docs/api/class-browser#browser-new-context-options
PLAYWRIGHT_CHANNEL=chromium
PLAYWRIGHT_STORAGE_STATE_PATH=
PLAYWRIGHT_USE_STEALTH_FLAGS=true
PLAYWRIGHT_HIDE_WEBDRIVER=true
PLAYWRIGHT_USE_STEALTH_PACKAGE=true
PLAYWRIGHT_SLOW_MO_MS=0
PLAYWRIGHT_BLOCK_RESOURCE_TYPES=

# Stress bot sem API (docker-compose.bot-stress.yml)
# Controle da consulta/lote
BOT_CONSULTA=04031769644
BOT_CONSULTAS_JSON=
BOT_REFINAR_BUSCA=true
BOT_HEADLESS=true
BOT_INCLUIR_BASE64=false
BOT_OUTPUT_DIR=output/stress-bot
# Mapeia para PLAYWRIGHT_SLOW_MO_MS no container de stress do bot
BOT_PLAYWRIGHT_SLOW_MO_MS=20
# Tipos bloqueados no stress do bot (ex.: font,media,image,stylesheet)
# Recomendado: font,media
BOT_PLAYWRIGHT_BLOCK_RESOURCE_TYPES=font,media
# Modo de bloqueio de imagem: off | third_party | all
BOT_PLAYWRIGHT_BLOCK_IMAGE_MODE=third_party
# Domínio principal para "third_party"
BOT_PLAYWRIGHT_PRIMARY_DOMAIN=portaldatransparencia.gov.br
# URLs com esses padrões nunca serão bloqueadas quando recurso=imagem
BOT_PLAYWRIGHT_IMAGE_ALLOW_PATTERNS=captcha,challenge,recaptcha,hcaptcha,cloudflare,human
